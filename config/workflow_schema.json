{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/n8n-workflow.schema.json",
  "type": "object",
  "required": ["name", "nodes", "connections"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "position"],
        "properties": {
          "id": { "type": ["string", "number"] },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "typeVersion": { "type": ["number", "string"], "nullable": true },
          "position": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "parameters": { "type": ["object", "array", "null"], "nullable": true }
        },
        "additionalProperties": true
      }
    },
    "connections": { "type": "object" },
    "active": { "type": ["boolean", "null"], "nullable": true },
    "settings": { "type": ["object", "null"], "nullable": true },
    "versionId": { "type": ["string", "number", "null"], "nullable": true }
  },
  "additionalProperties": true
}

